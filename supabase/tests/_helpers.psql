-- ════════════════════════════════════════════════════════════════════════════
-- Utilitários compartilhados pelos testes
--
-- Para exercitar RLS de verdade é preciso assumir o papel `authenticated` E
-- injetar um JWT com o `sub` do usuário — é de lá que `auth.uid()` lê. Rodar
-- como superusuário não testaria nada: superusuário ignora RLS.
-- ════════════════════════════════════════════════════════════════════════════

create schema if not exists tests;

-- Entra na sessão como um usuário específico.
create or replace function tests.authenticate_as(p_user_id uuid)
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config(
    'request.jwt.claims',
    json_build_object(
      'sub', p_user_id::text,
      'role', 'authenticated',
      'aud', 'authenticated'
    )::text,
    true
  );
end;
$$;

-- Entra pelo e-mail, que é mais legível no corpo dos testes.
create or replace function tests.authenticate_as_email(p_email text)
returns void
language plpgsql
as $$
declare
  v_id uuid;
begin
  select id into v_id from auth.users where email = p_email;
  if v_id is null then
    raise exception 'Usuário de teste não encontrado: %', p_email;
  end if;
  perform tests.authenticate_as(v_id);
end;
$$;

-- Volta a ser superusuário para preparar cenário entre asserções.
create or replace function tests.clear_authentication()
returns void
language plpgsql
as $$
begin
  perform set_config('role', 'postgres', true);
  perform set_config('request.jwt.claims', null, true);
end;
$$;

-- Atalhos para os usuários do seed.
create or replace function tests.mariana() returns uuid
  language sql immutable as $$ select '11111111-1111-1111-1111-111111111111'::uuid $$;
create or replace function tests.roberto() returns uuid
  language sql immutable as $$ select '11111111-1111-1111-1111-111111111112'::uuid $$;
create or replace function tests.camila() returns uuid
  language sql immutable as $$ select '11111111-1111-1111-1111-111111111113'::uuid $$;
