  language sql immutable as $$ select '22222222-2222-2222-2222-222222222222'::uuid $$;
create or replace function tests.central() returns uuid
  language sql immutable as $$ select '33333333-3333-3333-3333-333333333333'::uuid $$;
create or replace function tests.carlos() returns uuid
  language sql immutable as $$ select '44444444-4444-4444-4444-444444444441'::uuid $$;
create or replace function tests.jose() returns uuid
  language sql immutable as $$ select '44444444-4444-4444-4444-444444444442'::uuid $$;
