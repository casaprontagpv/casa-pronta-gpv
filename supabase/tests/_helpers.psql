-- Chamados do seed.
create or replace function tests.ticket_mariana() returns uuid
  language sql immutable as $$ select 'd0000000-0000-0000-0000-000000000001'::uuid $$;
create or replace function tests.ticket_roberto() returns uuid
  language sql immutable as $$ select 'd0000000-0000-0000-0000-000000000002'::uuid $$;
create or replace function tests.ticket_andre() returns uuid
  language sql immutable as $$ select 'd0000000-0000-0000-0000-000000000003'::uuid $$;
create or replace function tests.ticket_camila_solar() returns uuid
  language sql immutable as $$ select 'd0000000-0000-0000-0000-000000000004'::uuid $$;

create or replace function tests.tech_carlos() returns uuid
  language sql immutable as $$ select 'c0000000-0000-0000-0000-000000000001'::uuid $$;
create or replace function tests.tech_jose() returns uuid
  language sql immutable as $$ select 'c0000000-0000-0000-0000-000000000002'::uuid $$;
create or replace function tests.tech_carlos_eduardo() returns uuid
  language sql immutable as $$ select 'c0000000-0000-0000-0000-000000000003'::uuid $$;

-- Os testes rodam COMO `authenticated` para exercitar a RLS de verdade, então
-- esse papel precisa enxergar o próprio schema de apoio. Tudo aqui vive dentro
-- da transação do teste, que termina em ROLLBACK — nada disso chega ao banco real.
grant usage on schema tests to authenticated, anon, service_role;
grant execute on all functions in schema tests to authenticated, anon, service_role;
